# Get from BotFather — bot must be admin in the channel
BOT_TOKEN=

# Full URL of the family-archive upload endpoint
# e.g. https://family-archive.example.com/api/upload
ARCHIVE_URL=

# Numeric folder ID from the archive
ARCHIVE_FOLDER_ID=

# Optional: API key sent as X-API-Key header
ARCHIVE_API_KEY=

# Optional: OpenAI API key — enables OCR rename for PDFs starting with "DOC"
# and transcription (Spanish) + Russian summary of audio/voice messages
OPENAI_API_KEY=

# Required for backfill.py — get from https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
